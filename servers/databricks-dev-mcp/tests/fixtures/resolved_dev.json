{
 "bundle": {
  "name": "sample_bundle",
  "target": "dev",
  "mode": "development"
 },
 "workspace": {
  "root_path": "/Workspace/Users/someone@example.com/.bundle/sample_bundle/dev",
  "file_path": "/Workspace/Users/someone@example.com/.bundle/sample_bundle/dev/files"
 },
 "resources": {
  "jobs": {
   "daily_job": {
    "name": "[dev someone] daily-job",
    "schedule": {
     "pause_status": "PAUSED",
     "quartz_cron_expression": "0 0 6 * * ?",
     "timezone_id": "UTC"
    },
    "environments": [
     {
      "environment_key": "default",
      "spec": {
       "environment_version": "2"
      }
     }
    ],
    "tasks": [
     {
      "task_key": "report",
      "depends_on": [
       {
        "task_key": "refresh"
       },
       {
        "task_key": "ingest"
       }
      ],
      "notebook_task": {
       "notebook_path": "/Workspace/Users/someone@example.com/.bundle/sample_bundle/dev/files/src/report"
      }
     },
     {
      "task_key": "ingest",
      "environment_key": "default",
      "spark_python_task": {
       "python_file": "/Workspace/Users/someone@example.com/.bundle/sample_bundle/dev/files/src/ingest.py"
      }
     },
     {
      "task_key": "refresh",
      "depends_on": [
       {
        "task_key": "ingest"
       }
      ],
      "pipeline_task": {
       "pipeline_id": "${resources.pipelines.events_pipeline.id}"
      }
     }
    ]
   }
  },
  "pipelines": {
   "events_pipeline": {
    "name": "[dev someone] events-pipeline",
    "catalog": "main",
    "schema": "events",
    "serverless": true,
    "development": true,
    "channel": "CURRENT",
    "libraries": [
     {
      "glob": {
       "include": "/Workspace/Users/someone@example.com/.bundle/sample_bundle/dev/files/src/pipeline/**"
      }
     }
    ]
   }
  },
  "schemas": {
   "events_schema": {
    "name": "events",
    "catalog_name": "main"
   }
  }
 }
}