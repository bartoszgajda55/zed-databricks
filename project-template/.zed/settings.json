// Databricks project settings for Zed (generated from zed-databricks/project-template).
// Merge these keys into an existing .zed/settings.json rather than overwriting it.
{
  "terminal": {
    "env": {
      // Active bundle target / CLI profile for the `databricks` tasks, this project's terminals,
      // and the databricks-bundle-ls validation diagnostics.
      // Unset = the target marked `default: true` in databricks.yml and the DEFAULT profile.
      // "DATABRICKS_BUNDLE_TARGET": "dev",
      // "DATABRICKS_CONFIG_PROFILE": "DEFAULT"
    }
  },
  "languages": {
    "Python": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "ruff" } },
      "code_actions_on_format": { "source.organizeImports.ruff": true }
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          // Databricks runtime globals, so ruff doesn't report them as undefined (F821).
          // Merged over the project's ruff.toml / pyproject.toml settings.
          "configuration": { "builtins": ["spark", "sc", "dbutils", "display", "displayHTML"] }
        }
      }
    }
  }
}
