[
  {
    "label": "databricks: bundle validate",
    "command": "sh .zed/databricks/cli.sh bundle validate",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle plan",
    "command": "sh .zed/databricks/cli.sh bundle plan",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle deploy",
    "command": "sh .zed/databricks/cli.sh bundle deploy",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle run (pick resource)",
    "command": "sh .zed/databricks/cli.sh bundle run",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle run \"$ZED_SELECTED_TEXT\"",
    "command": "sh .zed/databricks/cli.sh bundle run \"$BUNDLE_RESOURCE\"",
    "env": {
      "BUNDLE_RESOURCE": "$ZED_SELECTED_TEXT"
    },
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle open (pick resource)",
    "command": "sh .zed/databricks/cli.sh bundle open",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ]
  },
  {
    "label": "databricks: bundle summary",
    "command": "sh .zed/databricks/cli.sh bundle summary",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "save": "all"
  },
  {
    "label": "databricks: bundle destroy (confirmation required)",
    "command": "sh .zed/databricks/cli.sh bundle destroy",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ],
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "databricks: pipelines dry-run on Databricks (deployed pipeline)",
    "command": "sh .zed/databricks/cli.sh pipelines dry-run",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ]
  },
  {
    "label": "databricks: pipelines logs (latest update)",
    "command": "sh .zed/databricks/cli.sh pipelines logs",
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": [
      "databricks-bundle"
    ]
  },
  {
    "label": "databricks: environments setup-local (bundle target's cluster)",
    "command": "sh .zed/databricks/cli.sh environments setup-local",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "databricks: environments setup-local (serverless)",
    "command": "sh .zed/databricks/cli.sh environments setup-local --serverless-version",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "databricks: auth login",
    "command": "databricks auth login",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "databricks: auth profiles",
    "command": "databricks auth profiles",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "databricks: auth describe",
    "command": "sh .zed/databricks/cli.sh auth describe",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "databricks-connect: run current file",
    "command": "PATH=\"$ZED_WORKTREE_ROOT/.venv/bin:$PATH\" python .zed/databricks/connect_runner.py \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "sdp: dry-run pipeline spec on local Spark (current file)",
    "command": "PATH=\"$ZED_WORKTREE_ROOT/.venv/bin:$PATH\" spark-pipelines dry-run --spec \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "sdp: run pipeline spec on local Spark (current file)",
    "command": "PATH=\"$ZED_WORKTREE_ROOT/.venv/bin:$PATH\" spark-pipelines run --spec \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pytest: all tests",
    "command": "PATH=\"$ZED_WORKTREE_ROOT/.venv/bin:$PATH\" python -m pytest",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "pytest: current file",
    "command": "PATH=\"$ZED_WORKTREE_ROOT/.venv/bin:$PATH\" python -m pytest \"$ZED_FILE\"",
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
